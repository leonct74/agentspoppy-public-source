{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ScopeDownSelfToTestThePoppyPolicy",
      "Effect": "Allow",
      "Action": ["sts:GetFederationToken", "sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "Ec2CanaryDeliberatelyBroadSoDenialsAreAttributable",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeVpcs",
        "ec2:DescribeTags",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-1" } }
    },
    {
      "Sid": "CognitoCanaryDeliberatelyBroadSoDenialsAreAttributable",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:CreateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:DescribeUserPool",
        "cognito-idp:ListUserPools",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:ListTagsForResource"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "eu-west-1" } }
    },
    {
      "Sid": "OptionalTier1Simulation",
      "Effect": "Allow",
      "Action": ["iam:SimulateCustomPolicy", "iam:GetContextKeysForCustomPolicy"],
      "Resource": "*"
    },
    {
      "Sid": "NeverTouchAnythingThatIsNotTheCanary",
      "Effect": "Deny",
      "Action": [
        "ec2:RunInstances",
        "ec2:TerminateInstances",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "cognito-idp:AdminCreateUser",
        "cognito-idp:AdminSetUserPassword",
        "cognito-idp:AdminDeleteUser",
        "cognito-idp:UpdateUserPool"
      ],
      "Resource": "*"
    }
  ]
}
