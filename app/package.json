    "tauri:dev:clean": "pkill -9 -f 'target/debug/agentspoppy' 2>/dev/null; rm -rf \"$HOME/Library/Caches/agentspoppy\" \"$HOME/Library/WebKit/agentspoppy\" \"$HOME/Library/HTTPStorages/agentspoppy\"; tauri dev",
    "tauri:build": "tauri build",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:check:live": "node scripts/release-check.mjs --live"
  },
  "dependencies": {
    "@agentspoppy/core": "*",
    "@agentspoppy/extension-sdk": "*",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-deep-link": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
